{
  "name": "@haseebeqx/pi-agent-lib",
  "version": "0.4.0",
  "description": "A small, library-first API for building agents with Pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haseebeqx/pi-agent-lib.git"
  },
  "homepage": "https://github.com/haseebeqx/pi-agent-lib#readme",
  "bugs": {
    "url": "https://github.com/haseebeqx/pi-agent-lib/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --import tsx --test test/**/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "pi",
    "agent",
    "ai",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
